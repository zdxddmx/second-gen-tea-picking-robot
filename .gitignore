# ---------------------------------------------------------------------------
# Build artefacts
# ---------------------------------------------------------------------------
build/
*.o
*.obj
*.elf
*.bin
*.hex
*.map
*.lst
*.su
*.d

# ---------------------------------------------------------------------------
# Generated data
#
# Everything under data/ is produced by running the project and can be
# regenerated with `python scripts/run_demo.py`.  It is ignored deliberately:
# a checked-in trace is a claim about a run that a reader cannot verify, and it
# can go stale the moment a constant changes.  The *method* is committed and the
# output is not -- see data/README.md, which is the one file kept here.
# ---------------------------------------------------------------------------
data/logs/*
data/results/*
!data/README.md
!data/logs/.gitkeep
!data/results/.gitkeep

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Debugger / flasher output
# ---------------------------------------------------------------------------
*.svd
*.openocd.log
openocd.log

# ---------------------------------------------------------------------------
# Local overrides.  Anything a developer needs to keep out of the repository
# goes here; the file itself is ignored.
# ---------------------------------------------------------------------------
.local/
*.local
