# ---------------------------------------------------------------------------
# Build artefacts
# ---------------------------------------------------------------------------
build/
*.o
*.obj
*.elf
*.bin
*.hex
*.map
*.lst
*.su
*.d

# ---------------------------------------------------------------------------
# Generated data
#
# The traces, figures and metrics are produced by the simulator and the demo,
# so they are not committed.  Two exceptions are kept on purpose:
#
#   data/results/      the figures the README links to, plus
#   data/logs/         a single reference run per scenario,
#
# because a reader opening the repository should be able to see the result
# without installing anything.  Everything else is regenerated by
# `python scripts/run_demo.py`.
# ---------------------------------------------------------------------------
data/logs/*.csv
data/logs/*.log
data/results/*.png
!data/results/README.md

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Debugger / flasher output
# ---------------------------------------------------------------------------
*.svd
*.openocd.log
openocd.log

# ---------------------------------------------------------------------------
# Local overrides.  Anything a developer needs to keep out of the repository
# goes here; the file itself is ignored.
# ---------------------------------------------------------------------------
.local/
*.local
